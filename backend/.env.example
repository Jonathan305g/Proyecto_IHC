# PostgreSQL: usar la URI del pooler sin sslmode; DATABASE_SSL aplica verificación TLS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:TU_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL=true
# Si Supabase requiere una CA particular, pegar PEM con saltos escapados como \n.
DATABASE_CA_CERT=
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# Clave secreta/service_role SOLO del servidor. Nunca usar en VITE_ ni subir a Git.
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
SUPABASE_STORAGE_BUCKET=evidencias
# Cuentas verificadas de Supabase Auth autorizadas; lista separada por comas.
AUTH_ALLOWED_EMAILS=integrante1@example.com,integrante2@example.com
# Directorio que contiene uploads/evidencias antiguos, solo para storage:migrate.
LEGACY_EVIDENCE_ROOT=.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ihc:grupo6:s3-02:respuesta:1.0",
  "title": "Contrato IA 1.0 - respuesta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "estado",
    "hallazgos",
    "observaciones_sin_hallazgo"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "estado": {
      "const": "borrador"
    },
    "hallazgos": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observacion_ids",
          "resumen",
          "categoria",
          "severidad",
          "mejora_sugerida"
        ],
        "properties": {
          "observacion_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^resultado:[1-9][0-9]{0,18}$",
              "maxLength": 29
            }
          },
          "resumen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "categoria": {
            "enum": [
              "navegacion",
              "comprension",
              "accesibilidad",
              "retroalimentacion",
              "eficiencia",
              "prevencion_errores",
              "contenido",
              "otro"
            ]
          },
          "severidad": {
            "enum": [
              "baja",
              "media",
              "alta",
              "critica"
            ]
          },
          "mejora_sugerida": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500,
            "pattern": "\\S"
          }
        }
      }
    },
    "observaciones_sin_hallazgo": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^resultado:[1-9][0-9]{0,18}$",
        "maxLength": 29
      }
    }
  }
}
